+def _single_planet_candidate(planets):
+    """Return a dated but unconfirmed blind candidate when it is inspectable."""
+    if planets.get('status') != 'planet_epoch_not_identifiable':
+        return None
+    rows = _strongest_planet_rows(planets.get('candidate_matches') or [])
+    candidates = planets.get('candidates') or []
+    if len(rows) != 1 or not candidates:
+        return None
+    candidate = candidates[0]
+    epoch = candidate.get('epoch_tdb')
+    try:
+        sigma_minutes = float(candidate.get('conditional_time_sigma_minutes'))
+    except (TypeError, ValueError):
+        return None
+    if not epoch or not np.isfinite(sigma_minutes) or sigma_minutes <= 0:
+        return None
+    uncertainty = (f"±{_fmt(sigma_minutes/60, 0)} h" if sigma_minutes >= 120
+                   else f"±{_fmt(sigma_minutes, 0)} min")
+    return dict(row=rows[0], epoch=epoch, uncertainty=uncertainty)
+
